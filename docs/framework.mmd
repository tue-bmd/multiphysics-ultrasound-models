%% Roadmap toward an integrated multiphysics-ultrasound framework.
%% Colored boxes are the current v0 studies.
%% Light-gray boxes show the target integrated framework.
%% Dashed arrows are conceptual interfaces that are not yet integrated.
flowchart TB
    T["coupled vascularized-tissue model"]
    F["acoustic, mechanical, and<br/>transport fields"]
    O["B-mode, SWE, and CEUS<br/>measurement operators"]
    I["joint probabilistic inversion"]
    P["physiological parameters<br/>and uncertainty"]

    T --> F --> O --> I --> P

    S1["study 01 (v0)<br/>vascular-network coupling"]
    S2["study 02 (v0)<br/>ideal-field identifiability"]
    S3["study 03 (v0)<br/>shared-operator identifiability"]
    S4["study 04 (v0)<br/>vascular-mechanical confounding"]

    S1 -.-> T
    S1 -.-> F
    S2 -.-> F
    S2 -.-> I
    S3 -.-> O
    S3 -.-> I
    S4 -.-> F
    S4 -.-> I

    classDef planned fill:#f2f2f2,stroke:#9e9e9e,stroke-width:1px,color:#3d3d3d;
    classDef v0a fill:#cfe3f7,stroke:#2b6cb0,stroke-width:2px,color:#11304f;
    classDef v0b fill:#d8f0d8,stroke:#2f7d32,stroke-width:2px,color:#14401a;
    classDef v0c fill:#fbe0d0,stroke:#c05621,stroke-width:2px,color:#5a2b0c;
    classDef v0d fill:#eadcf4,stroke:#805ad5,stroke-width:2px,color:#3f2860;

    class T,F,O,I,P planned;
    class S1 v0a;
    class S2 v0b;
    class S3 v0c;
    class S4 v0d;

    linkStyle 4,5,6,7,8,9,10,11 stroke-dasharray: 5 5,stroke:#777;
